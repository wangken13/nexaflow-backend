COMPOSE_PROJECT_NAME=nexaflow
IMAGE_TAG=latest
HTTP_PORT=80
HTTPS_PORT=443
AUTH_COOKIE_SECURE=true
SSL_CERT_PATH=/opt/nexaflow/certs/wkkk.site/fullchain.pem
SSL_KEY_PATH=/opt/nexaflow/certs/wkkk.site/private.key

JWT_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-bytes

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_APP_USER=trade_app
MYSQL_APP_PASSWORD=replace-with-a-strong-application-password

REDIS_PASSWORD=replace-with-a-strong-redis-password
RABBITMQ_USER=trade_app
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
MINIO_ROOT_USER=trade_minio_admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-a-strong-nacos-password
NACOS_AUTH_TOKEN=replace-with-a-base64-encoded-32-byte-token
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=replace-with-a-random-service-identity

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Spug uses a complete template URL. Set both URLs when login and registration
# use different templates; a single approved template URL may be used for both.
SMS_PROVIDER=spug
SPUG_SMS_NAME=NexaFlow
SPUG_SMS_LOGIN_URL=
SPUG_SMS_REGISTER_URL=
SMS_ENDPOINT=
SMS_API_TOKEN=
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=
